@baseUrl = http://127.0.0.1:8080
@reservationId = 1
@userId = 1
@attemptNumber = 8c514efc-142b-4ec3-96df-c041287f1769
@paymentKey = PK-OPEN-RUSH-001

### 예약 결제 승인
# 유효한 선점 예약 ID를 사용합니다. 금액은 서버가 예약에서 읽습니다.
# 같은 시도의 재요청은 attemptNumber와 paymentKey를 유지합니다.
# 202 PENDING이면 같은 요청으로 승인 결과를 다시 확인합니다.
# 예약 확정 실패 시 내부적으로 환불합니다. REFUND_REQUIRED이면 같은 요청으로 환불을 다시 시도합니다.
# 환불이 완료되면 REFUNDED를 반환합니다.
POST {{baseUrl}}/reservations/{{reservationId}}/confirm
Content-Type: application/json

{
  "userId": {{userId}},
  "attemptNumber": "{{attemptNumber}}",
  "paymentKey": "{{paymentKey}}"
}

### 확정 예약 전체 취소
# 예약 취소와 자원 반환이 먼저 완료됩니다. PG 장애 시 refundStatus는 PENDING입니다.
# 같은 사유로 재요청하면 미완료 환불만 같은 멱등 키로 다시 시도합니다.
POST {{baseUrl}}/reservations/{{reservationId}}/cancel
Content-Type: application/json

{
  "userId": {{userId}},
  "cancelReason": "사용자 요청"
}
